# ─────────────────────────────────────────────────────────────────
# Aftermath Finance (Sui) — configuration template
#
#   cp .env.example .env
#   # set AF_WALLET_ADDRESS, then:
#   nunchi doctor
#
# Every value below has a working default except AF_WALLET_ADDRESS.
# Do NOT commit your filled-in .env.
# ─────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────

# Your Sui address. This is PUBLIC — it is not a secret.
# Used to discover your perpetuals account and your gas pool.
AF_WALLET_ADDRESS=

# ── Signing (optional; read paths work without it) ───────────────

# Your wallet secret. Needed only to SIGN transactions.
# This build ships without a signer and never reads this value —
# `doctor` only reports whether it is present.
# Treat as a secret: never commit it, never paste it into a log.
# AF_WALLET_KEY=

# ── API ──────────────────────────────────────────────────────────

# The one host setting. This IS production mainnet despite the name;
# the legacy v1 host is retired and no longer serves the API.
# Override only if you are pointed at a local or staging deployment.
AF_API_BASE_URL=https://v2-preview.aftermath.finance

# ── Gas — your choice, three modes ───────────────────────────────
#
#   sponsored  a gas pool pays; you need NO SUI at all   (default)
#   self       your own SUI pays
#   dynamic    any coin you pick pays, via /api/dynamic-gas
#
# Change this ONE line to switch. `doctor` validates the mode's
# prerequisites and will never silently fall back to another mode.
AF_GAS_MODE=sponsored

# Which coin pays gas in `dynamic` mode. Ignored otherwise.
# Defaults to the collateral coin (USDC), i.e. USDC-as-gas.
# AF_GAS_COIN_TYPE=0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC

# Explicit gas budget in MIST (0.05 SUI). Always set deliberately —
# auto-estimation under-counts storage costs and fails later as
# InsufficientGas on a transaction that simulated fine.
AF_GAS_BUDGET_MIST=50000000

# ── Trading ──────────────────────────────────────────────────────

# Collateral coin for the perpetuals account. Defaults to USDC on Sui;
# accounts and markets are discovered using it, so you never paste a
# market id or account id by hand.
# AF_COLLATERAL_COIN_TYPE=0xdba34672e30cb065b1f93e3ab55318768fd6fef66c15942c9f7cb846e2f900e7::usdc::USDC

# Default leverage for new positions. Aftermath is ISOLATED margin.
AF_LEVERAGE=5

# Milliseconds to wait after a mutation before re-reading state.
# Sui settles asynchronously; reading immediately returns a stale view.
AF_SETTLE_MS=1500

# ── Safety ───────────────────────────────────────────────────────

# MASTER ARMING SWITCH.
# false (default) = builds, previews and inspects, but never signs
#                   or submits anything.
# true            = live orders, IF a signer is also wired up.
# Turnkey means "no wiring required", NOT "trades on first run".
AF_ARMED=false

# Kill switch: cancel all orders if the strategy loop goes quiet
# for this many seconds. There is no server-side dead-man switch,
# so the bot owns this.
AF_HEARTBEAT_TIMEOUT_S=90

# HTTP retry attempts for transient failures (5xx / 429 / timeouts).
AF_MAX_RETRIES=4

# ── Builder code / integrator fees (optional) ────────────────────
#
# v3.0.0: integratorId is a u32 NUMBER (the old address-string
# `integratorAddress` is gone), and the fee field is `integratorFee`
# (formerly `takerFee`).
# AF_INTEGRATOR_ID=
# AF_INTEGRATOR_FEE=
